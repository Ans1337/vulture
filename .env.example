# Copy to .env and fill in (never commit .env).

# Access token for the API and dashboard (required). start.sh generates one if empty; or: openssl rand -hex 24
APP_TOKEN=
# Set to 1 when behind Caddy/nginx so rate limits use the real client IP (last X-Forwarded-For entry)
TRUST_PROXY_HEADERS=0
RATE_API_PER_MIN=120
RATE_SCANS_PER_HOUR=6
RATE_AUTH_FAILS_PER_MIN=10
MAX_UPLOAD_MB=25
BODY_READ_TIMEOUT=30

# Vultr Serverless Inference: the AI analyst. Leave empty to get rule-based verdicts only.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pick a model id from: curl -H "Authorization: Bearer $VULTR_INFERENCE_API_KEY" https://api.vultrinference.com/v1/models
AGENT_MODEL=

# Sandbox matrix
SCAN_PERSONAS=developer,ci
SCAN_CLOCKS=0,+90d
SCAN_STEP_TIMEOUT=30
# Set to 0 if scans fail with "exec ... operation not permitted" (Docker from snap / strict AppArmor)
SANDBOX_NO_NEW_PRIVILEGES=1

# Storage (Part 2): SQLite inside the vulture-data volume. Nothing to set.

# Where scans run. docker = containers on this host; vultr = a throwaway Vultr VM per scan (Part 5)
SANDBOX_MODE=docker
VULTR_API_KEY=
VULTR_SSH_KEY_ID=
VULTR_REGION=ewr
VULTR_PLAN=vc2-2c-4gb
# Optional: snapshot with Docker + images pre-built (boot ~1 min instead of ~4), and a firewall group
VULTR_SNAPSHOT_ID=
VULTR_FIREWALL_GROUP_ID=
VULTR_BOOT_TIMEOUT=600
VULTR_VM_MAX_AGE=3600

# AI investigator (Part 6): needs the inference key + AGENT_MODEL above
INVESTIGATOR_MAX_STEPS=8
INVESTIGATOR_MAX_RERUNS=3

# Resource limits: every sandbox run gets a time cap and a memory cap (swap off). Defaults shown.
LIMIT_FETCH_MEM=1g
LIMIT_DETONATE_MEM=1g
LIMIT_SINKHOLE_MEM=256m
LIMIT_TMPFS_SIZE=1g
LIMIT_FETCH_CPUS=1
LIMIT_DETONATE_CPUS=2
LIMIT_SINKHOLE_CPUS=0.5
LIMIT_PIDS=512
LIMIT_FETCH_TIMEOUT=300
LIMIT_DETONATE_TIMEOUT=900
LIMIT_SCAN_TIMEOUT=1500
# Fleet caps and lifecycle
LIMIT_MAX_CONCURRENT=2
LIMIT_MAX_QUEUED=8
LIMIT_HISTORY_MAX=200
LIMIT_ORPHAN_MAX_AGE=3600
