# Copy to .env and fill in (never commit .env).

# Vultr Serverless Inference: the AI analyst. Leave empty to get rule-based verdicts only.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pick a model id from: curl -H "Authorization: Bearer $VULTR_INFERENCE_API_KEY" https://api.vultrinference.com/v1/models
AGENT_MODEL=

# Sandbox matrix
SCAN_PERSONAS=developer,ci
SCAN_CLOCKS=0,+90d
SCAN_STEP_TIMEOUT=30
# Set to 0 if scans fail with "exec ... operation not permitted" (Docker from snap / strict AppArmor)
SANDBOX_NO_NEW_PRIVILEGES=1

# Where scans run: docker = containers on this host (default), vultr = a throwaway Vultr VM per scan.
SANDBOX_MODE=docker
# vultr mode: an API key with Access Control limited to this server's IP (my.vultr.com > Account > API).
VULTR_API_KEY=
# This server's public IPv4 as a /32. Scan VMs only accept SSH from here.
VULTR_SSH_ALLOW_CIDR=
VULTR_REGION=sto
VULTR_PLAN=vc2-2c-4gb
# Optional: a snapshot with Docker and both images already in it (boots in ~1 min instead of ~4).
VULTR_SNAPSHOT_ID=
# Safety nets: at most this many scan VMs at once; the janitor deletes scan VMs older than this.
VULTR_MAX_VMS=3
VULTR_MAX_AGE_MIN=60
