{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vulture scan report (draft)",
  "type": "object",
  "required": ["target", "verdict"],
  "properties": {
    "target": { "type": "object", "properties": {
      "input": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "string" },
      "commit": { "type": "string" }, "sha256": { "type": "string" } } },
    "verdict": { "enum": ["safe", "suspicious", "malware"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string" },
    "indicators": { "type": "array", "items": { "type": "object" } },
    "honeytoken_hits": { "type": "array", "items": { "type": "object" } },
    "network": { "type": "array", "items": { "type": "object" } },
    "dormant_code_paths": { "type": "array", "items": { "type": "object" } }
  }
}
